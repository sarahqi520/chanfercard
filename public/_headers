# Cloudflare Pages cache rules for chanfercard.com
# Deployed via GitHub Actions (wrangler pages deploy out)
#
# Notes:
# - Cloudflare Pages purges the cache automatically on every deployment,
#   so a long s-maxage is safe for HTML here.
# - /_next/static/ must be explicitly allowed: robots.txt no longer blocks it
#   and Googlebot needs the CSS/JS to render the site correctly.

/*
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800

/*.txt
  Cache-Control: public, max-age=3600

/*.xml
  Cache-Control: public, max-age=3600
